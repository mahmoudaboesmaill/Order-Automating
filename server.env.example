# Set these values in Windows before starting server.py. Do not commit real secrets.
GEMINI_API_KEY=replace-with-a-new-key
# Optional: rotate through multiple keys when one reaches its rate limit.
# GEMINI_API_KEYS=key-one,key-two
# The server also accepts GEMINI_API_KEY_2, GEMINI_API_KEY_3, ... as separate variables.

# Optional Gemini fallback. If Gemini is exhausted, the server sends the same
# invoice image/PDF to Mistral OCR and returns the same JSON shape to Android.
# MISTRAL_API_KEY=replace-with-a-mistral-key
# Optional rotation: MISTRAL_API_KEYS=key-one,key-two
# Optional model override: MISTRAL_OCR_MODEL=mistral-ocr-latest
# OCR_PROVIDER=auto (default), or set to mistral temporarily to test Mistral directly.

# Optional: enables request authentication after the Android app is configured with
# the same value. Leave unset until both sides are configured.
# ORDER_ROBOT_TOKEN=replace-with-a-long-random-value

# Optional: defaults to %LOCALAPPDATA%\OrderAutomating
# ORDER_ROBOT_RUNTIME_DIR=C:\\Path\\To\\Runtime
